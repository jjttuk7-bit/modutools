# 모두의 도구 (modutools) — 환경변수 예시
# 이 파일은 Git 에 커밋되는 안내 템플릿입니다.
# 실제 값은 .env.local 또는 Netlify 대시보드의 환경변수에 등록하세요.

# ─────────────────────────────────────────────
# 사이트 절대 URL
# ─────────────────────────────────────────────
# sitemap.xml, 캐노니컬, OG, JSON-LD 에 사용됩니다.
# 미설정 시 기본값: https://modutools.kr
# SITE_URL=https://modutools.kr
# VITE_SITE_URL=https://modutools.kr

# ─────────────────────────────────────────────
# Google AdSense
# ─────────────────────────────────────────────
# AdSense 승인 전에는 비워두세요. 비어 있는 동안은 AdSlot 컴포넌트가
# 아무것도 렌더하지 않습니다(빈 광고 영역 노출 방지).
#
# 승인 후 발급받은 클라이언트 ID 를 아래 형식으로 넣으세요:
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
